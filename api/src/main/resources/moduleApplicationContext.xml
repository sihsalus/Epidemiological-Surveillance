<?xml version="1.0" encoding="utf-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="surveillance.dao" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.api.db.HibernateSurveillanceDao">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>
    <bean id="surveillance.clinical" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.api.db.ClinicalData" />
    <bean id="surveillance.access" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.api.SurveillanceAccess" />
    <bean id="surveillance.catalog" class="org.openmrs.module.sihsalusepidemiologicalsurveillance.api.ClinicalCatalogService">
        <property name="clinical" ref="surveillance.clinical" />
    </bean>
    <bean id="surveillance.service" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager" />
        <property name="target">
            <bean class="org.openmrs.module.sihsalusepidemiologicalsurveillance.api.impl.SurveillanceServiceImpl">
                <property name="dao" ref="surveillance.dao" />
                <property name="clinical" ref="surveillance.clinical" />
                <property name="catalog" ref="surveillance.catalog" />
                <property name="access" ref="surveillance.access" />
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors" />
        <property name="transactionAttributeSource" ref="transactionAttributeSource" />
    </bean>
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.sihsalusepidemiologicalsurveillance.api.SurveillanceService</value>
                <ref bean="surveillance.service" />
            </list>
        </property>
    </bean>
</beans>
<?xml version="1.0" encoding="UTF-8"?>
 
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

 
	<changeSet id="epidemiologysurveillance-2016-08-02-12-21" author="raff">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="epidemiologysurveillance_item"/></not>
		</preConditions>
		<comment>
			Creating the epidemiologysurveillance_item table
		</comment>
		<createTable tableName="epidemiologysurveillance_item">
			<column name="epidemiologysurveillance_item_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="uuid" type="char(38)">
				<constraints nullable="false" unique="true"></constraints>
			</column>
			<column name="owner" type="int" />
			<column name="description" type="varchar(255)" />
		</createTable>
        <addForeignKeyConstraint constraintName="epidemiologysurveillance_item_owner_fk" baseTableName="epidemiologysurveillance_item" baseColumnNames="owner"  referencedTableName="users"
                                 referencedColumnNames="user_id" />
    </changeSet>
    <include file="liquibase-surveillance.xml"/>
    <include file="liquibase-english-entities.xml"/>
    <include file="liquibase-surveillance-case.xml"/>
    <include file="liquibase-remove-scheduler.xml"/>
    <include file="liquibase-case-laboratory.xml"/>
    <include file="liquibase-case-snapshot.xml"/>
    <include file="liquibase-age-groups.xml"/>
    <include file="liquibase-geography.xml"/>
    <include file="liquibase-coordinate-codes.xml"/>
    <include file="liquibase-endemic-config.xml"/>
    <include file="liquibase-event-state.xml"/>
    <include file="liquibase-notification-time.xml"/>
    <include file="liquibase-notification-config.xml"/>
</databaseChangeLog>

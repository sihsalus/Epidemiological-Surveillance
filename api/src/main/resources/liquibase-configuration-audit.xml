  <addForeignKeyConstraint constraintName="fk_outbreak_config_creator" baseTableName="surveillance_outbreak_config" baseColumnNames="creator" referencedTableName="users" referencedColumnNames="user_id"/>
  <addForeignKeyConstraint constraintName="fk_outbreak_config_changed" baseTableName="surveillance_outbreak_config" baseColumnNames="changed_by" referencedTableName="users" referencedColumnNames="user_id"/>
  <rollback>
   <dropForeignKeyConstraint baseTableName="surveillance_outbreak_config" constraintName="fk_outbreak_config_changed"/>
   <dropForeignKeyConstraint baseTableName="surveillance_outbreak_config" constraintName="fk_outbreak_config_creator"/>
   <dropColumn tableName="surveillance_outbreak_config" columnName="date_changed"/>
   <dropColumn tableName="surveillance_outbreak_config" columnName="changed_by"/>
   <dropColumn tableName="surveillance_outbreak_config" columnName="date_created"/>
   <dropColumn tableName="surveillance_outbreak_config" columnName="creator"/>
  </rollback>
 </changeSet>
